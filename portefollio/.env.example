# Mot de passe de l'espace /admin : long et unique (20 caractères ou plus)
ADMIN_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères (ex. `openssl rand -hex 32`). La changer déconnecte toutes les sessions admin.
SESSION_SECRET=
# Ajouté automatiquement par le Blob store Vercel
BLOB_READ_WRITE_TOKEN=
# URL publique du site, sans slash final (ex. https://malcolmboukaka.fr)
NEXT_PUBLIC_SITE_URL=
